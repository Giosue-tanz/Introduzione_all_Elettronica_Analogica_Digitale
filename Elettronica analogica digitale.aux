\@writefile{lof}{\contentsline {figure}{\numberline {2.12}{\ignorespaces Cella passa-basso passiva (RC). La funzione di trasferimento è $A_{LP} = 1/(1+i\omega /\omega _{LP})$, con $\omega _{LP}=1/(RC)$. Al di sopra di $\omega _{LP}$ il guadagno cala di $-20\,\mathrm  {dB/decade}$.}}{22}{figure.2.12}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{Filtro Passa-Alto (HP)}{22}{subsubsection*.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2.13}{\ignorespaces Cella passa-alto passiva (CR). La funzione di trasferimento è $A_{HP} = (i\omega /\omega _{HP})/(1+i\omega /\omega _{HP})$, con $\omega _{HP}=1/(RC)$. Al di sotto di $\omega _{HP}$ il guadagno cala di $+20\,\mathrm  {dB/decade}$.}}{22}{figure.2.13}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{Filtro Passa-Banda (Cascata LP--HP)}{22}{subsubsection*.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2.14}{\ignorespaces Filtro passa-banda ottenuto dalla cascata LP--HP. Lo Stadio~1 (tratteggio sinistro) è un passa-basso RC; lo Stadio~2 (tratteggio destro) è un passa-alto CR. I due stadi interagiscono tramite il fattore di partizione $Z_{in}^{(2)}/(Z_{in}^{(2)}+Z_{out}^{(1)})$.}}{23}{figure.2.14}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{Analisi della Funzione di Trasferimento del Passa-Banda}{23}{subsubsection*.11}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2.15}{\ignorespaces Diagramma di Bode del modulo per il filtro passa-banda ($R_1=R_2$, $\omega _{HP}=300\,\mathrm  {rad/s}$, $\omega _{LP}=10^4\,\mathrm  {rad/s}$). La curva verde ($|A_{LP}|$) attenua le alte frequenze; la curva blu ($|A_{HP}|$) attenua le basse; la curva rossa ($|T_{BP}|$) raggiunge il massimo alla frequenza di centro-banda $\bar  \omega \approx 1732\,\mathrm  {rad/s}$ (tratto arancione). La linea tratteggiata grigia indica il livello $-3\,\mathrm  {dB}$ ($|T|=1/\sqrt  {2}$), che definisce le frequenze di taglio del passa-banda.}}{24}{figure.2.15}\protected@file@percent }

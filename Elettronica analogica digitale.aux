\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces Simboli circuitali del BJT npn (sinistra) e pnp (destra). Nel npn la freccia all'emettitore punta verso l'esterno (convenzione: direzione della corrente); nel pnp punta verso il transistor.}}{28}{figure.3.2}\protected@file@percent }

\@writefile{toc}{\contentsline {subsubsection}{Caratteristiche d'Uscita del Modello CE}{29}{subsubsection*.20}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces Caratteristiche d'uscita $I_C(V_{CE})$ del modello CE ($\beta _F=120$). Le curve blu (una per ogni valore di $I_B$ da $2$ a $12\,\mu \mathrm  {A}$) mostrano le tre zone: \emph  {saturazione} (a sinistra, dove $I_C\propto V_{CE}$), \emph  {regione attiva} (centrale, curve quasi orizzontali) e \emph  {interdizione} (curva $I_B=0$). La retta di carico tratteggiata (rossa) interseca le curve nel punto di lavoro $Q$.}}{30}{figure.3.4}\protected@file@percent }
